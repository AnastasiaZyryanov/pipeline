{
    "Chunker": {
      "type": "SemanticChunkerFunction",
      "embedding_model": "nomic-ai/nomic-embed-text-v2-moe",
      "percentile": 85,
      "overlap":  1
  },
    "Cleaner": {
      "type": "CleanerWithScript",
      "script": "scripts/clean.py",
      "entrypoint": "clean"
    },
    "SentimentAnalyzer": {
    "type": "SAwithAttention",
    "model": "cardiffnlp/twitter-roberta-base-sentiment-latest"
  },
    "KeywordExtractor": {
    "type": "KEwithKeyBERT",
    "runner": {  
      "type": "VLLMRunner",
      "gpu": "0",
      "port": "8001",
      "model": "google\/gemma-3-12b-it",
      "api_key": "EMPTY"         
    },
    "user_template": "I have the following document:\\n{document}\\nWith the following candidate keywords:\\n{candidates}\\nBased on the information above, improve the candidate keywords to best describe the topic of the document.\\nReturn ONLY comma-separated keywords.\\n",
    "seed_keywords": ["creation", "building", "cooperation", "construction", "map", "territory", "regions", "change", "static", "bounded", "border", "space", "negotiation", "competition", "organization", "command", "control", "decentralized", "planning", "strategy", "altruism", "kinship", "selfishness", "isolation", "community", "collective", "together", "multiplayer"],
    "embedding_model": {"name": "Qwen/Qwen3-Embedding-8B","dtype": "float16", "device": "cpu"},
    "top_n": 5,
    "keyphrase_size": 3,
    "stopwords": "english",
    "min_df": 3,
    "use_maxsum": true
    }
}